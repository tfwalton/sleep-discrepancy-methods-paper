volume = {74},
year = {1970}
}



@article{edinger1995,
abstract = {Examined the distribution of sleep time misperceptions among 173 insomniacs to determine if such misperceptions might relate to Ss' clinical characteristics. Data were collected and compared from both objective and subjective sleep measures. As a group, Ss produced sleep estimates that were significantly lower than polysomnographically determined sleep times. However, Ss' sleep time perceptions were widely distributed across a broad continuum, which ranged between gross underestimates and remarkable overestimates of actual sleep times. Results also showed that subgroups, formed on the basis of presenting complaints and diagnostic criteria, differed in regard to the magnitude and direction of their sleep distortions. Moreover, these differences appeared consistent with the types of objective sleep disturbances these subgroups commonly experience. (PsycInfo Database Record (c) 2021 APA, all rights reserved)},
author = {Edinger, Jack D and Fins, Ana I},
doi = {10.1093/sleep/18.4.232},
issn = {1550-9109},
